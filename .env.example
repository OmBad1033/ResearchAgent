# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# `.env.example` is committed so others know which variables to set.

# --- OpenRouter ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key-here
# Any model ID OpenRouter supports, e.g.:
#   anthropic/claude-sonnet-4-5
#   anthropic/claude-3-5-sonnet
#   openai/gpt-4o
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: OpenRouter shows your app in rankings if these are set.
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=ResearchAgent
# Orchestrator planner model (default if unset: meta/muse-spark-1.3-contributor)
ORCHESTRATOR_MODEL=meta/muse-spark-1.3-contributor

# --- AWS Bedrock (bearer-token auth, custom endpoint) ---
# Bedrock API key. For AWS Bedrock API keys, see:
#   https://docs.aws.amazon.com/bedrock/latest/userguide/api-keys.html
# For Bedrock-compatible proxies (e.g. bedrock-mantle), use the token
# issued by that provider.
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-bearer-token
BEDROCK_MODEL_ID=openai.gpt-oss-120b
BEDROCK_BASE_URL=https://bedrock-mantle.eu-west-1.api.aws/v1
AWS_REGION=eu-west-1
